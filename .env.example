APP_NAME=Sirali
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Compagnie à laquelle le site public est dédié (voir config/site.php).
SITE_COMPAGNIE_ID=1

# Comptes super_admin garantis présents en base au premier chargement de l'écran de
# connexion (voir config/super_admins.php, Utilisateur::seedSuperAdminsParDefaut()) —
# sans mot de passe ici, le compte correspondant n'est pas créé. Ne jamais committer de
# vraies valeurs : à définir uniquement dans le .env réel de chaque environnement.
SUPER_ADMIN_1_PASSWORD=
SUPER_ADMIN_2_PASSWORD=
SUPER_ADMIN_3_PASSWORD=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_annexpress_laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Emails réellement envoyés (validation de billet, confirmation de réservation en
# ligne — voir ListeEntenteService/ReservationEnLigneService) : "log" se contente
# d'écrire l'email dans storage/logs/laravel.log sans jamais rien envoyer, pratique en
# local mais à remplacer par un vrai "smtp" en production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
